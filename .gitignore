# Python cache files
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Python build artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
conda-env/

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Jupyter/IPython
.ipynb_checkpoints/
profile_default/
ipython_config.py

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*.swn
*.bak
*.tmp
*.temp
*~

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
*.out
*.err
output.txt

# Runtime-generated experiment outputs
model_train/results/
model_train/records/
model_train/runs/
model_train/checkpoints/
model_test/results/
model_test/runs/

# Temporary files generated by baseline methods
model_test/method/**/CITEMP.csv
model_test/method/**/bpdtemp.txt*
model_test/method/**/seeds.txt
model_test/method/**/graph.txt
model_test/method/**/graph.txt_out

# Large generated arrays and serialized intermediate artifacts
*.npy
*.npz
*.pkl
*.pickle

# Generated figures and tables
*.png
*.jpg
*.jpeg
*.svg
*.pdf
*.xlsx
*.xls

# Keep source datasets and pretrained checkpoints tracked unless explicitly removed.
!experiments_figure/data/assets/*.pdf
!experiments_figure/data/reference/*.pdf
experiments_figure/outputs/paper/
!model_train/dataset/**
!model_test/dataset/**
!model_test/method/modelGym/trained_models/**
!model_test/method/modelGym/Diffusion_model/robustness_metrics_models/**
